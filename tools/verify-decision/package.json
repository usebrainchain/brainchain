  "description": "Check a BrainChain decision against the chain: the published record, its hashes, its confidence and the thresholds the contracts applied.",
  "license": "MIT",
  "author": "BrainChain",
  "homepage": "https://docs.usebrainchain.com/verifying-decisions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usebrainchain/brainchain.git",
    "directory": "tools/verify-decision"
  },
