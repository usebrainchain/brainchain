{
  "name": "brainchain-verify",
  "version": "0.15.0",
  "description": "Check a BrainChain decision against the chain: the published record, its hashes, its confidence and the thresholds the contracts applied.",
  "license": "MIT",
  "author": "BrainChain",
  "homepage": "https://docs.usebrainchain.com/verifying-decisions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usebrainchain/brainchain.git",
    "directory": "tools/verify-decision"
  },
  "bugs": "https://github.com/usebrainchain/brainchain/issues",
  "keywords": [
    "brainchain",
    "jev",
    "verify",
    "decision",
    "onchain"
  ],
  "type": "module",
  "bin": {
    "brainchain-verify": "dist/cli.js"
  },
  "main": "dist/verify.js",
  "types": "dist/verify.d.ts",
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "default": "./dist/deployments.js"
    },
    "./phala": {
      "types": "./dist/phala.d.ts",
      "default": "./dist/phala.js"
    },
    "./zerox": {
      "types": "./dist/zerox.d.ts",
      "default": "./dist/zerox.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/deployments.mjs && tsc -p tsconfig.json",
    "abi": "node scripts/abi.mjs",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@x402/evm": "2.30.0",
    "@x402/fetch": "2.30.0",
    "typescript": "5.9.3",
    "viem": "2.57.13"
  }
}
